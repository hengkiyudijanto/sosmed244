# Contoh konfigurasi environment — SALIN ke .env.local lalu isi nilainya.
# JANGAN commit .env.local (sudah ada di .gitignore).

# Koneksi database PostgreSQL (Neon / Postgres terkelola mana pun).
# Ambil dari Neon Console → Connection Details, atau `neon connection-string`.
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Koneksi tanpa connection pooling — dipakai untuk migrasi (Prisma migrate).
DATABASE_URL_UNPOOLED=

# Alamat publik aplikasi ini. Dipakai untuk menyusun URL berkas media yang
# diambil oleh TikTok/Instagram.
#
# Di produksi WAJIB diisi domain aslinya, mis. https://sosmed244.vercel.app
# Kalau dibiarkan localhost, platform tidak akan bisa mengambil berkasnya saat
# pengiriman nyata diaktifkan.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Akun admin pertama (dipakai skrip scripts/seed.ts).
ADMIN_EMAIL=
ADMIN_NAMA=
ADMIN_PASSWORD=

# ===== Kredensial pengiriman ke platform =====
# Selama SOSMED_MODUS bukan "nyata", pengiriman hanya SIMULASI (tidak menyentuh
# akun sosial mana pun). Di produksi, isi lewat Environment Variables Vercel —
# berkas ini tidak ikut ter-deploy.
SOSMED_MODUS=mock

# --- Instagram (jalur Facebook Login) ---
# Diambil dari Graph API Explorer: panggil me/accounts, lalu lihat
# instagram_business_account pada halaman yang dituju.
#   SOSMED_IG_USER_ID  = ID akun Instagram (angka panjang), BUKAN username
#   SOSMED_IG_TOKEN    = Page Access Token halaman itu
# SOSMED_IG_API_VERSI=v26.0    # v21.0 dimatikan 21 Jan 2027
# SOSMED_IG_USER_ID=
# SOSMED_IG_TOKEN=

# --- TikTok (Content Posting API) ---
# Dua yang CLIENT_ ini hanya dipakai untuk memperbarui token otomatis;
# tokennya sendiri berlaku 24 jam saja, jadi tanpa keduanya pengiriman TikTok
# akan mati dalam sehari.
# SOSMED_TIKTOK_CLIENT_KEY=
# SOSMED_TIKTOK_CLIENT_SECRET=
# SOSMED_TIKTOK_TOKEN=
# SOSMED_TIKTOK_MODE=DRAFT   # selain "PUBLIK" dianggap DRAFT

# Rahasia yang dipakai Vercel Cron / penjadwal luar untuk memanggil
# /api/cron/jadwal. Tanpa ini endpoint menolak SEMUA permintaan (503).
# CRON_SECRET=

